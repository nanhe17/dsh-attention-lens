{
  "name": "dsh-attention-lens",
  "version": "0.1.0",
  "description": "Attention Lens for DeepSeek Harness: estimated attention share, cold-zone heatmap, and dilution forecast for long sessions.",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "projection.mjs",
    "tokens.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "README.zh.md",
    "METHODOLOGY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test tests/scoring.test.cjs tests/projection.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.4.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "attention",
    "context",
    "observability"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
